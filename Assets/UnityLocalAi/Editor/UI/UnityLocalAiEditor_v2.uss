:root {
    --primary-color: #4f7ecf;
    --background-dark: #1e1e1e;
    --surface-dark: #2d2d2d;
    --panel-dark: #252526;
    --header-dark: #333333;
    --text-primary-dark: #d4d4d4;
    --text-secondary-dark: #a0a0a0;
    --border-dark: #404040;
    --green-500: #22c55e;
}

.root {
    width: 100%;
    height: 100%;
    background-color: var(--background-dark);
    color: var(--text-primary-dark);
}

.header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 8px 16px;
    background-color: var(--header-dark);
    border-bottom-width: 1px;
    border-bottom-color: var(--border-dark);
}

.header-left {
    flex-direction: row;
    align-items: center;
}

.header-icon {
    width: 24px;
    height: 24px;
    margin-right: 8px;
    -unity-background-image-tint-color: var(--primary-color);
}

.main-container {
    flex-direction: row;
    flex-grow: 1;
}

.left-panel {
    width: 288px;
    background-color: var(--panel-dark);
    padding: 16px;
}

.right-panel {
    flex-grow: 1;
    flex-direction: column;
    background-color: var(--surface-dark);
}

.h2 {
    font-size: 18px;
    -unity-font-style: bold;
    margin-bottom: 12px;
}

.h3 {
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--text-secondary-dark);
    margin-bottom: 8px;
}

.button-group {
    flex-direction: row;
    margin-bottom: 12px;
}

.button {
    flex-grow: 1;
    background-color: #4a4a4a;
    color: var(--text-primary-dark);
    border-radius: 4px;
    padding: 8px;
    font-size: 12px;
}

.button:hover {
    background-color: #5a5a5a;
}

.button.primary {
    background-color: var(--primary-color);
    color: white;
}

.button.primary:hover {
    background-color: #6a9aef;
}

.chat-history-list .unity-list-view__item {
    background-color: transparent;
    border-radius: 4px;
    padding: 12px;
}

.chat-history-list .unity-list-view__item:hover {
    background-color: rgba(255, 255, 255, 0.05);
}

.chat-history-list .unity-list-view__item--selected {
    background-color: #4a4a4a;
}

.server-status-section, .lm-studio-settings-section {
    margin-top: 24px;
}

.server-status-content, .settings-content {
    background-color: var(--surface-dark);
    border-radius: 4px;
    padding: 12px;
}

.status-indicator-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}

.status-indicator {
    width: 12px;
    height: 12px;
    border-radius: 6px;
    background-color: var(--green-500);
    margin-right: 8px;
}

.status-label {
    color: var(--green-500);
    font-size: 14px;
}

.setting-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
}

.setting-row .unity-text-field {
    width: 66%;
}

.setting-row .unity-dropdown-field {
    width: 66%;
}

.setting-row .unity-slider {
    width: 50%;
}

.temp-label {
    background-color: #4a4a4a;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 12px;
}

.chat-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 16px;
    border-bottom-width: 1px;
    border-bottom-color: var(--border-dark);
}

.chat-scroll-view {
    flex-grow: 1;
    padding: 24px;
}

.input-container {
    padding: 16px;
    border-top-width: 1px;
    border-top-color: var(--border-dark);
    flex-direction: row;
    align-items: center;
}

.chat-input {
    flex-grow: 1;
    height: 48px;
}

.send-button {
    width: 48px;
    height: 48px;
    background-color: transparent;
    border-width: 0;
    margin-left: 12px;
}

.send-icon {
    width: 24px;
    height: 24px;
    -unity-background-image-tint-color: var(--primary-color);
}

.message-bubble {
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: 12px;
    max-width: 80%;
}

.message-user {
    align-self: flex-end;
}

.message-assistant {
    align-self: flex-start;
}

.message-icon {
    width: 32px;
    height: 32px;
    border-radius: 16px;
    background-color: #4a4a4a;
    -unity-background-image-tint-color: var(--text-primary-dark);
}

.message-text {
    padding: 12px;
    border-radius: 8px;
    white-space: normal;
}

.message-user .message-text {
    background-color: var(--primary-color);
    color: white;
    margin-right: 12px;
}

.message-assistant .message-text {
    background-color: #4a4a4a;
    margin-left: 12px;
}

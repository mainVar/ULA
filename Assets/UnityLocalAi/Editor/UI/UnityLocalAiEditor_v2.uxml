<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UnityLocalAi/Editor/UI/UnityLocalAiEditor_v2.uss?fileID=7433441132597879392&amp;guid=8b1d6aa53ca6125459e38e70456822a9&amp;type=3#UnityLocalAiEditor_v2" />
    <ui:VisualElement name="MainWindow" class="main-window">
        <ui:VisualElement name="Header" class="header">
            <ui:Label text="Unity Local AI" class="header-title" />
            <ui:VisualElement name="HeaderButtons">
                <ui:Button name="SettingsButton" class="header-button" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="MainContent" class="main-content">
            <ui:VisualElement name="LeftPanel" class="left-panel">
                <ui:VisualElement name="ChatHistorySection" class="config-section">
                    <ui:Label text="Chat Sessions" class="section-header" />
                    <ui:Button name="NewChatButton" text="New Chat" class="new-chat-button" />
                    <ui:ListView name="ChatHistoryList" class="chat-history-list" />
                </ui:VisualElement>
                <ui:VisualElement name="ServerStatusSection" class="config-section">
                    <ui:Label text="Server Status" class="section-header" />
                    <ui:VisualElement class="status-indicator-row">
                        <ui:VisualElement name="PythonServerStatusIndicator" class="status-indicator" />
                        <ui:Label name="PythonServerStatusLabel" text="-" class="status-label" />
                    </ui:VisualElement>
                    <ui:Button name="StartServerButton" text="Start Server" />
                </ui:VisualElement>
                <ui:VisualElement name="LMStudioConfigSection" class="config-section">
                    <ui:Label text="LM Studio" class="section-header" />
                    <ui:Label name="LMStudioStatusLabel" text="-" class="status-label" />
                    <ui:Button name="RefreshLMStatusButton" class="icon-button" />
                    <ui:TextField name="LMStudioHost" label="Host" />
                    <ui:IntegerField name="LMStudioPort" label="Port" />
                    <ui:VisualElement style="flex-direction: column; align-items: center; height: 70px; flex-grow: 1;">
                        <uie:DropdownField name="LMStudioModel" label="Model" style="flex-grow: 1; align-self: center; width: 99%; height: 50%; align-content: center;" />
                        <ui:Button name="RefreshModelsButton" text="Refresh" style="margin-left: 5px;" />
                    </ui:VisualElement>
                    <ui:VisualElement class="slider-with-field">
                        <ui:Slider name="LMStudioTemperature" label="Temp" low-value="0" high-value="1" />
                        <ui:FloatField name="LMStudioTemperatureField" />
                    </ui:VisualElement>
                    <ui:Button name="ApplyLMConfigButton" text="Apply &amp; Save" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="RightPanel" class="right-panel">
                <ui:ScrollView name="ChatScrollView" class="chat-scroll-view" />
                <ui:VisualElement name="InputContainer" class="input-container">
                    <ui:TextField name="ChatInput" multiline="true" class="chat-input" />
                    <ui:Button name="SendButton" class="send-button" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

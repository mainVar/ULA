<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <!-- Header -->
    <ui:VisualElement name="header" class="header">
        <ui:VisualElement class="header__left">
            <ui:Image name="header-icon" class="header__icon" />
            <ui:Label text="Unity Local AI" class="header__title" />
        </ui:VisualElement>
        <ui:VisualElement class="header__right">
            <!-- Native window controls are used -->
        </ui:VisualElement>
    </ui:VisualElement>

    <!-- Body -->
    <ui:VisualElement name="body-container" class="body-container">
        <!-- Sidebar -->
        <ui:VisualElement name="sidebar" class="sidebar">
            <ui:VisualElement class="sidebar__section">
                <ui:Label text="Chat Sessions" class="sidebar__title" />
                <ui:VisualElement class="sidebar__button-group">
                    <ui:Button name="new-chat-button" text="New Chat" />
                    <ui:Button name="delete-chat-button" text="Delete Chat" />
                </ui:VisualElement>
                <ui:ScrollView name="chat-list" />
            </ui:VisualElement>

            <ui:VisualElement class="sidebar__section">
                <ui:Label text="Server Status" class="sidebar__title" />
                <ui:VisualElement class="sidebar__status-box">
                    <ui:VisualElement class="sidebar__status-display">
                        <ui:VisualElement name="server-status-indicator" />
                        <ui:Label name="server-status-label" text="Disconnected" />
                    </ui:VisualElement>
                    <ui:Button name="start-server-button" text="Start Server" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="sidebar__section sidebar__section--settings">
                <ui:Label text="LM Studio Settings" class="sidebar__title" />
                <ui:VisualElement class="sidebar__settings-box">
                    <ui:VisualElement class="setting-item">
                        <ui:Label text="Host" class="setting-item__label" />
                        <ui:TextField name="host-text-field" class="setting-item__field" />
                    </ui:VisualElement>
                    <ui:VisualElement class="setting-item">
                        <ui:Label text="Port" class="setting-item__label" />
                        <ui:TextField name="port-text-field" class="setting-item__field" />
                    </ui:VisualElement>
                    <ui:VisualElement class="setting-item">
                        <ui:Label text="Model" class="setting-item__label" />
                        <ui:DropdownField name="model-dropdown" class="setting-item__field" />
                    </ui:VisualElement>
                    <ui:Button name="refresh-models-button" text="Refresh" />
                    <ui:VisualElement class="setting-item">
                        <ui:Label text="Temp" class="setting-item__label" />
                        <ui:Slider name="temperature-slider" low-value="0" high-value="1" />
                        <ui:Label name="temperature-value-label" text="0.8" />
                    </ui:VisualElement>
                    <ui:Button name="apply-button" text="Apply &amp; Save" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Main Panel -->
        <ui:VisualElement name="main-panel" class="main-panel">
            <ui:VisualElement name="chat-header" class="main-panel__header">
                <ui:Label text="Chat with Local AI" />
                <ui:Button name="settings-button" text="Settings" />
            </ui:VisualElement>

            <ui:ScrollView name="chat-history" class="main-panel__chat-history" />

            <ui:VisualElement class="main-panel__input-area">
                <ui:TextField name="user-input-text-field" placeholder="Type your message..." />
                <ui:Button name="send-button">
                    <ui:Image name="send-button-icon" />
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
